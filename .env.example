# Copy to .env.local for local development. Never commit real values.
# Set the canonical Vercel production origin before building/deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Verified production origin: https://havenfield-portfolio.vercel.app
# Vercel sets VERCEL_ENV. Use APP_ENV only for independent deployments.
APP_ENV=development
# Exact trusted mutation origin. Vercel Preview defaults to https://${VERCEL_URL}.
SITE_URL=http://localhost:3000

# Blank locally uses ignored SQLite; PostgreSQL is mandatory on Vercel.
# Use a pooled postgres:// or postgresql:// connection URL, not prisma://.
DATABASE_URL=
# Optional direct PostgreSQL connection for migration commands.
DIRECT_DATABASE_URL=
# Optional recovery targets. Restore refuses nonempty databases and never defaults to DATABASE_URL.
RESTORE_DATABASE_URL=
RESTORE_SQLITE_PATH=
# Optional custom CA certificate; remote TLS verification remains enabled.
DATABASE_CA_CERT=

# Run npm run admin:password to generate the hash and session secret.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Required for uploads on Vercel. Local uploads use ignored .data/uploads.
BLOB_READ_WRITE_TOKEN=
# Daily retention job authentication; generate independently per environment.
CRON_SECRET=
# Optional independent private backup directory, outside this checkout.
BACKUP_DESTINATION=

# Dedicated recovery staging; never use the live upload directory.
RESTORE_UPLOAD_DIR=
RESTORE_BLOB_READ_WRITE_TOKEN=
RESTORE_APP_ENV=
